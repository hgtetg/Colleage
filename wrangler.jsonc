{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "campus-hub",
  "main": "dist/server/index.js",
  "compatibility_date": "2026-08-30",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "dist/client",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "campus-hub-db",
      "database_id": "375d5ed0-4b07-448f-bcfd-e60fe0246779",
      "migrations_dir": "drizzle"
    }
  ],
  "r2_buckets": [
    {
      "binding": "FILES",
      "bucket_name": "campus-hub-files"
    }
  ],
  "observability": {
    "enabled": true
  }
}
